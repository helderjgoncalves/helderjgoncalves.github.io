{
  "name": "helder-cv",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Personal landing page for Hélder Gonçalves — Lead Software Engineer",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist/server && node scripts/prerender.mjs",
    "preview": "vite preview",
    "test": "node --test scripts/dist.test.mjs",
    "lint": "tsc -b --noEmit",
    "cards": "node scripts/og-cards/render.mjs",
    "cv": "node scripts/cv/build.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "sass": "^1.105.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
